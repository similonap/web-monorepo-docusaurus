{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && node scripts/course.cjs --course courses/webprogramming build",
  "ignoreCommand": "cd ../.. && git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- courses/webprogramming docs src static codesandbox scripts videos package.json package-lock.json",
  "outputDirectory": ".course/build",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": { "gh-pages": false }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
